# Set this to the deployed Azure Functions API base URL, for example /api or https://your-functions.azurewebsites.net/api
VITE_API_BASE_URL=

# Enable Microsoft Entra ID / Azure Static Web Apps admin sign-in in deployed environments.
VITE_ENABLE_AUTH=false

# Optional support address used for paper-copy requests on the signer disclosure.
VITE_SUPPORT_EMAIL=

# Use the ACS-backed remote request flow when VITE_API_BASE_URL is configured.
